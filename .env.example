# App
NODE_ENV=development
PORT=3000
APP_NAME=WhatsApp BSP

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whatsapp-bsp
MONGODB_DB_NAME=whatsapp-bsp

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRES_IN=7d

# Admin Seed
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Admin@123456

# Meta / WhatsApp Cloud API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token

# Redis (required for BullMQ campaign queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Partner top-up (POST /api/v1/public/v1/partner/wallet/topup). Shared with the partner
# server (Swaad Boss: WHATSAPP_PARTNER_SECRET). Leave empty to keep partner routes off.
PARTNER_TOPUP_SECRET=

# Frontend (admin/vendor panel) — the browser is sent here after paying
FRONTEND_URL=http://localhost:3001
# Optional override of the payment result page (default: ${FRONTEND_URL}/vendor-billing/result)
BILLING_RESULT_URL=

# Airpay v4 (website plan purchases). Leave AIRPAY_MERCHANT_ID empty to keep checkout off.
# sandbox | production. Production credits only after Airpay's verify API confirms the payment.
AIRPAY_ENV=sandbox
AIRPAY_MERCHANT_ID=
AIRPAY_USERNAME=
AIRPAY_PASSWORD=
AIRPAY_SECRET=
AIRPAY_CLIENT_ID=
AIRPAY_CLIENT_SECRET=
# Optional: 32-char encryption key from Airpay. Default: md5(username~:~password)
AIRPAY_ENCRYPTION_KEY=
# Where Airpay sends the browser back — must be on the domain registered with Airpay.
AIRPAY_RETURN_URL=https://api.yourdomain.com/api/v1/billing/airpay/return
# Register this with Airpay as the IPN / callback URL:
#   https://api.yourdomain.com/api/v1/billing/airpay/ipn
# Optional overrides
AIRPAY_PAYMENT_URL=https://payments.airpay.co.in/pay/v4/
AIRPAY_API_BASE=https://kraken.airpay.co.in/airpay/pay/v4/api
AIRPAY_CHECKSUM_TZ=Asia/Kolkata
